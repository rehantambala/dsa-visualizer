PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/dsavisualizer
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string

# Google Sign-In (optional). Create an OAuth Client ID (type "Web application")
# at https://console.cloud.google.com/apis/credentials, add your frontend origin
# (e.g. http://localhost:5173) under "Authorized JavaScript origins", then put the
# Client ID here AND in frontend/.env as VITE_GOOGLE_CLIENT_ID. Leaving this unset
# just disables the Google button - the app works fine without it.
GOOGLE_CLIENT_ID=
