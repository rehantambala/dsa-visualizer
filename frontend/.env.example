VITE_API_BASE_URL=http://localhost:4000

# Where the Linked List visualizer's Socket.io collaboration connects. Unlike
# VITE_API_BASE_URL (used for REST calls, which go through the vercel.json
# rewrite proxy in production so the auth cookie stays same-site), a websocket
# connection can't be proxied that way and always needs the backend's real,
# absolute URL. In production, set this to your Render backend URL - leaving
# VITE_API_BASE_URL itself unset in production so REST calls go through the
# proxy instead. See frontend/src/services/api.js for the full explanation.
VITE_SOCKET_URL=http://localhost:4000

# Google Sign-In (optional). Use the same Client ID you put in backend/.env
# as GOOGLE_CLIENT_ID. Create one at
# https://console.cloud.google.com/apis/credentials
# ("Create Credentials" -> "OAuth client ID" -> "Web application"), and add this
# app's URL (e.g. http://localhost:5173) under "Authorized JavaScript origins".
# Leaving this blank just hides/disables the Google button - everything else
# still works.
VITE_GOOGLE_CLIENT_ID=

