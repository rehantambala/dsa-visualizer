# Dependencies
node_modules/

# Environment variables - never commit real secrets. Copy .env.example to
# .env locally and fill in real values; .env itself must never be tracked.
.env
.env.*
!.env.example
!frontend/.env.example
!backend/.env.example

# Build output
dist/
build/
coverage/

# Logs
*.log
npm-debug.log*

# OS/editor cruft
.DS_Store
.vscode/
.idea/

# macOS Finder custom-folder-icon file (literally "Icon\r"; git strips one \r, hence two)
Icon
